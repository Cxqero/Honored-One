// Ink splatter mask for the Unlimited Void transitions. mode 0: radial burst from (cx, cy); mode 1: a horizontal
// wipe from the left. Jagged, spiky front, satellite droplets. Outputs an opacity. Plane spans x in [-a,a], y in [-1,1].
float fbm(float x, float y, float s, int oct) {
    float a = 0.5, f = 0.0, fx = x, fy = y;
    for (int i = 0; i < oct; i++) { f += a * snoise(point(fx, fy, s)); fx *= 2.1; fy *= 2.1; a *= 0.5; }
    return f;
}
shader ink(float prog = 0.0, int mode = 0, float cx = 0.0, float cy = 0.0, float aspect = 1.0, float seed = 1.0,
           output float Fac = 0)
{
    float x = P[0], y = P[1];
    float m = 0.0;
    if (mode == 0) {
        vector d = vector(x - cx, y - cy, 0);
        float r = length(d);
        float th = atan2(d[1], d[0]);
        // front radius per angle: big lobes, jagged edges, occasional long jets
        float lobes = fbm(cos(th) * 1.3, sin(th) * 1.3, seed, 3);
        float jag = fbm(cos(th) * 9.0, sin(th) * 9.0, seed + 3.0, 3);
        float spikes = fbm(cos(th) * 26.0, sin(th) * 26.0, seed + 5.0, 2);
        float jets = pow(max(0.0, snoise(point(th * 7.0, seed, 7.0))), 4.0) * 2.2;
        float grow = prog * prog * (3.0 - 2.0 * prog);
        float front = grow * (0.85 + 0.5 * lobes + 0.28 * jag + 0.14 * spikes + jets * (0.35 + grow)) * 2.6;
        float edge = 0.012 + 0.02 * grow;
        m = 1.0 - smoothstep(front - edge, front + edge, r + 0.05 * fbm(x * 14.0, y * 14.0, seed + 9.0, 2));
        // droplets flung ahead of the front
        for (int i = 0; i < 70; i++) {
            float a = cellnoise(point(i, seed, 1.0)) * M_2PI;
            float dist = (0.3 + 1.2 * cellnoise(point(i, seed, 2.0))) * (0.4 + grow * 1.6);
            float rad = (0.004 + 0.03 * pow(cellnoise(point(i, seed, 3.0)), 2.0)) * smoothstep(0.05, 0.4, prog);
            point c = point(cx + cos(a) * dist, cy + sin(a) * dist, 0);
            float dd = length(vector(x, y, 0) - c);
            m = max(m, 1.0 - smoothstep(rad * 0.85, rad * 1.1, dd));
        }
    } else {
        float front = -aspect * 1.2 + prog * aspect * 3.2;
        float wob = 0.35 * fbm(y * 1.5, 0.0, seed, 3) + 0.12 * fbm(y * 8.0, 1.0, seed + 2.0, 3);
        float jets = pow(max(0.0, snoise(point(y * 3.0, seed, 4.0))), 5.0) * 0.9;
        m = 1.0 - smoothstep(front + wob + jets - 0.02, front + wob + jets + 0.02, x);
        for (int i = 0; i < 60; i++) {
            float yy = (cellnoise(point(i, seed, 1.0)) * 2.0 - 1.0);
            float ahead = 0.1 + 0.8 * cellnoise(point(i, seed, 2.0));
            float rad = 0.006 + 0.035 * pow(cellnoise(point(i, seed, 3.0)), 2.0);
            point c = point(front + ahead, yy, 0);
            float dd = length(vector(x, y, 0) - c);
            m = max(m, 1.0 - smoothstep(rad * 0.85, rad * 1.1, dd));
        }
    }
    Fac = clamp(m, 0.0, 1.0);
}
