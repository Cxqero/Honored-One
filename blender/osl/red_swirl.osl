// Reversal: Red — outward-bursting turbulent swirl (additive). Opposite handedness to Blue, filaments fan outward.
vector rot2(vector p, float a) {
    float c = cos(a), s = sin(a);
    return vector(p[0] * c - p[1] * s, p[0] * s + p[1] * c, p[2]);
}
float fbm(point p, int oct) {
    float a = 0.5, f = 0.0;
    point q = p;
    for (int i = 0; i < oct; i++) { f += a * snoise(q); q *= 2.07; a *= 0.5; }
    return f;
}
shader red_swirl(float twist = -1.8, float rays = 9.0, float seed = 3.0, float gain = 1.0, int objspace = 0,
                 output color Color = 0)
{
    point Po = objspace ? transform("object", P) : P;
    vector p = vector(Po[0], Po[1], 0);
    float r = length(p) + 1e-4;
    float th = atan2(p[1], p[0]);
    vector sw = rot2(p, twist * log(r));
    float n1 = fbm(point(sw[0] * 4.0, sw[1] * 4.0, seed), 5);
    float n2 = fbm(point(sw[0] * 11.0, sw[1] * 11.0, seed + 4.0), 4);
    // radial spikes: sharp rays bursting out
    float spike = pow(0.5 + 0.5 * cos(th * rays + 2.5 * n1 + twist * 3.0 * log(r)), 6.0);
    float fil = smoothstep(0.0, 0.6, n2 + 0.3 * spike);
    float prof = exp(-pow(r / 0.28, 1.5)) * 1.6 + exp(-pow((r - 0.18) / 0.12, 2.0)) * 0.8;
    float edge = 1.0 - smoothstep(0.6, 0.98, r);
    float Iv = (0.55 * fil + 0.9 * spike * (0.3 + fil)) * prof * edge * gain;
    color deep = color(0.55, 0.0, 0.02);
    color hot = color(1.0, 0.18, 0.08);
    color white = color(1.0, 0.85, 0.75);
    color c = mix(deep, hot, smoothstep(0.1, 0.7, Iv));
    c = mix(c, white, smoothstep(0.9, 1.8, Iv));
    Color = c * Iv;
}
